<resources>
    <style name="Theme.MonetizeKit" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/sample_canvas</item>
        <item name="android:navigationBarColor">@color/sample_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MonetizeKit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sample_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MonetizeKit</item>
    </style>
</resources>
